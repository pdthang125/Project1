{
  "name": "vku-field-survey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "deploy:pages": "npm run build && wrangler pages deploy frontend/dist --project-name=vku-field-survey",
    "deploy:pages:ci": "wrangler pages deploy frontend/dist --project-name=vku-field-survey"
  },
  "dependencies": {
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "idb": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
